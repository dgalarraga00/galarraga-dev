# ---------------------------------------------------------------------------
# Delivery for "La comanda" (src/app/api/comanda/route.ts)
#
# Without these two values the form validates and then refuses honestly, with a
# direct mailto fallback, instead of pretending the message was sent.
#
# ---------------------------------------------------------------------------
# OPTION A — no domain required (start here)
# ---------------------------------------------------------------------------
# Resend's test sender `onboarding@resend.dev` can ONLY deliver to the address
# the Resend account was created with. That restriction does not matter here:
# the order is addressed to you, so you are the only recipient.
#
#   1. Sign up at https://resend.com with dgalarraga00@gmail.com — the same
#      address as `profile.email` in src/content/site.ts. This has to match, or
#      Resend rejects the send with a 403.
#   2. Create an API key.
#   3. Copy this file to `.env.local` and use:
#
#        RESEND_API_KEY=re_xxxxxxxxxxxx
#        COMANDA_FROM="Comanda <onboarding@resend.dev>"
#
# The visitor's address rides along as reply-to, so hitting Reply answers the
# client directly. Reply-to is not a recipient, so it does not break the rule.
#
# ---------------------------------------------------------------------------
# OPTION B — your own domain (later)
# ---------------------------------------------------------------------------
# Needed the day you want mail to reach anyone other than yourself: an
# auto-reply to the client, a newsletter, notifications to a teammate.
#
#   1. Buy a domain and verify it in Resend (it walks you through the DNS
#      records).
#   2. COMANDA_FROM="Comanda <pedidos@tudominio.com>"
#
# A personal Gmail can never be the FROM address. Providers reject mail that
# claims a domain the sender does not control — that is the whole point of
# domain verification.
# ---------------------------------------------------------------------------

RESEND_API_KEY=
COMANDA_FROM="Comanda <onboarding@resend.dev>"
